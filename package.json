{
  "name": "shark-ui",
  "version": "1.0.0",
  "private": true,
  "description": "shadcn/ui-style components built on Ark UI.",
  "keywords": [
    "headless",
    "a11y",
    "react",
    "shadcn",
    "ark-ui",
    "ui",
    "components"
  ],
  "homepage": "https://shark.vini.one",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharkui-inc/shark-ui"
  },
  "license": "MIT",
  "author": "Vinicius Vicentini <viniciusvicentini@live.com>",
  "contributors": [
    {
      "name": "Vinicius Vicentini",
      "email": "viniciusvicentini@live.com",
      "url": "https://github.com/vinihvc"
    }
  ],
  "scripts": {
    "build": "pnpm registry:build && next build",
    "dev": "next dev",
    "postinstall": "fumadocs-mdx",
    "lint:check": "ultracite check",
    "lint:fix": "ultracite fix",
    "registry:build": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.mts",
    "start": "next start",
    "test": "tsx --import ./test/setup-dom.ts --test lib/*.test.ts test/*.test.tsx",
    "typecheck": "next build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,mts,css,md,mdx}": [
      "pnpm lint:fix"
    ]
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.92",
    "@ark-ui/react": "^5.39.1",
    "@formisch/react": "^1.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@internationalized/date": "^3.12.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@takumi-rs/core": "^2.12.0",
    "@tanstack/ai": "^0.52.1",
    "@tanstack/ai-client": "^0.30.0",
    "@tanstack/ai-react": "^0.23.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.1.2",
    "@teispace/next-themes": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.89",
    "clsx": "^2.1.1",
    "code-inspector-plugin": "^2.0.7",
    "date-fns": "^4.4.0",
    "front-matter": "^4.0.2",
    "fumadocs-core": "16.15.1",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.1",
    "jotai": "^2.20.3",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "takumi-js": "^2.12.0",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.10.6"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=26"
  }
}
